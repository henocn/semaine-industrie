# Nginx — Semaine de l'industrie 2026
# Cible : /etc/nginx/sites-available/semaineindustrie.tg
# (installé par deploy/setup.sh — écrase l'ancienne conf)
#
# HTTPS / HSTS / 404 réel : appliquer à la main
# deploy/nginx-https-hsts.conf (pas deploy.sh). Voir l’en-tête de ce fichier.

upstream industrie_api {
    server 127.0.0.1:3005;
    keepalive 8;
}

server {
    server_name semaineindustrie.tg www.semaineindustrie.tg;

    root /var/www/semaine-industrie/frontend/dist;
    index index.html;

    client_max_body_size 12m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /images/ {
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location /brand/ {
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Espace orga / login → sous-domaine backoffice
    location = /login {
        return 302 https://backoffice.semaineindustrie.tg/login;
    }

    location ^~ /orga {
        return 302 https://backoffice.semaineindustrie.tg$request_uri;
    }

    location = /bilan {
        return 302 https://backoffice.semaineindustrie.tg/orga;
    }

    location /uploads/ {
        proxy_pass http://industrie_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 7d;
        add_header Cache-Control "public";
    }

    location /api/ {
        proxy_pass http://industrie_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location /socket.io/ {
        proxy_pass http://industrie_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    error_page 404 /404.html;

    # Routes applicatives dynamiques ou de redirection : coquille vide app.html (noindex).
    location ~ ^/(o|passage|passeport|questions|questionnaire|inscription|ressources)(/|$) {
        try_files $uri $uri/index.html /app.html;
    }

    location = /app.html {
        expires -1;
    }

    # Pages publiques pré-rendues : fichier réel, sinon vraie 404 (pas de repli sur l'accueil).
    location / {
        expires -1;
        try_files $uri $uri/index.html =404;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/semaineindustrie.tg/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/semaineindustrie.tg/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.semaineindustrie.tg) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = semaineindustrie.tg) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name semaineindustrie.tg www.semaineindustrie.tg;
    return 404; # managed by Certbot
}
