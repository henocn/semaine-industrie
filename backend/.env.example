NODE_ENV=development
PORT=3005
API_PREFIX=/api/v1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=semaine_industrie
DB_USER=postgres
DB_PASSWORD=postgres

JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=1d

ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
N8N_WEBHOOK_URL=

# WhatsApp Cloud API (bot)
# Préférer un jeton SYSTÈME permanent (Meta Business > Utilisateurs système >
# Générer un jeton > jamais d'expiration > whatsapp_business_messaging).
# Puis: bash deploy/set-wa-token.sh 'EAA...'
# Les jetons Graph Explorer / « Generate Access Token » expirent ~24h.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=si2026-wa-verify

# Logs : dossier backend/logs/ (gitignored). SQL off sauf DB_LOGGING=true
LOG_LEVEL=info
DB_LOGGING=false

# Prod : voir deploy/env.production.example (PORT=3005, PM2 industrie-api)
# ALLOWED_ORIGINS=https://semaineindustrie.tg,https://www.semaineindustrie.tg
# PUBLIC_APP_URL=https://semaineindustrie.tg
# SUPERADMIN_EMAIL=orga@semaineindustrie.tg
# SUPERADMIN_PASSWORD=…
