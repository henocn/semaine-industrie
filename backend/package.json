{
  "name": "semaine-industrie-backend",
  "version": "1.0.0",
  "description": "Semaine de l'industrie 2026 — API (Node.js + Express + PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:superadmin": "node scripts/ensure-superadmin.js"
  },
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/multer": "^2.3.0",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.3"
  }
}
